# 复制为 .env 后填写。勿将 .env 提交到 Git。
# 变量名与生产环境一致（前缀均为 FASTAPI_），微信登录需与线上一致时填写与服务器相同的小程序 AppID / AppSecret。
# 行首不要使用空格或 Tab；不要使用 UTF-8 BOM，否则变量可能读不出来。

# 微信小程序（与线上一致时与服务器 .env / systemd EnvironmentFile 中的值相同）
FASTAPI_WX_APP_ID=
FASTAPI_WX_APP_SECRET=

# 可选：本地数据库、JWT 等
# FASTAPI_DATABASE_URL=mysql+aiomysql://root:123456@localhost:3306/home_cook
# FASTAPI_SECRET_KEY=your-secret-key-change-in-production

# 腾讯云 COS（若本地需要上传/STS）
# FASTAPI_COS_SECRET_ID=
# FASTAPI_COS_SECRET_KEY=
# FASTAPI_COS_BUCKET=
# FASTAPI_COS_REGION=ap-guangzhou
